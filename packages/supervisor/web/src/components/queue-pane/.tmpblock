    <button
      v-for="r in shown"
      :key="it.r.t.id"
      class="row"
      :class="[`t-${it.r.tone}`, it.r.tone === 'bad' ? 'bad' : '', it.r.t.id === current ? 'on' : '']"
      role="tab"
      :aria-selected="it.r.t.id === current ? 'true' : 'false'"
      :aria-current="it.r.t.id === current ? 'true' : 'false'"
      :data-state="it.r.tone"
      :data-tid="it.r.t.id"
      :data-shard="it.r.t.shard || ''"
      :data-tip="it.r.tip"
      @click="touchThread(it.r.t.id); emit('pick', it.r.t.id)"
    >
      <span class="body">
        <span class="nm">
          <!--
            状态点挂在标题行里面，与第一行标题上下居中对齐。
            原来是 `.row` 的直接子元素，而 `.row` 是 `align-items: center`——点会被居中在
            「标题 + 模型 + 阶段」三行的整体中心，与第一行对不上。放进 nm 里用 align-self
            就自然跟标题同一行。
          -->
          <i class="dot" :class="it.r.tone" />
          <em class="sid">#{{ it.r.short }}</em>
          <span class="nmtext">{{ it.r.title }}</span>
          <em v-if="it.r.t.promoted_at && !it.r.retry" class="pin">置顶</em>
          <em v-if="it.r.retry">重派 {{ it.r.retry }}</em>
        </span>
        <span
          class="mdl"
          :data-tip="
            (it.r.model ? `模型 ${it.r.model.raw}` : '派单记录里没有模型字段') +
            (it.r.ctx ? ` · 上下文 ${it.r.ctx}（日志 _meta.contextUsed / contextWindow）` : ' · 上下文 未上报')
          "
        >
          <template v-if="it.r.model">
            <span class="mn">{{ it.r.model.name }}</span>
            <span v-if="it.r.model.ver" class="mv">{{ it.r.model.ver }}</span>
          </template>
          <span v-else class="na">模型 未记录</span>
          <span v-if="it.r.ctx" class="mctx">· 上下文 {{ it.r.ctx }}</span>
          <span v-else class="mctx na">· 上下文 未上报</span>
        </span>
        <span class="mt">
          <span>{{ it.r.at ? `${it.r.at} 启动` : "启动 未记录" }}</span>
          <i class="msep">·</i>
          <span>耗时 {{ it.r.durText || "无采样" }}</span>
          <i class="msep">·</i>
          <span class="spend" :class="{ na: !it.r.spend }" :data-tip="it.r.spendTip"
            >消耗 <span class="spendnum">{{ it.r.spend || NO_USAGE }}</span
            ><span v-if="it.r.spendUnit" class="spendunit"> {{ it.r.spendUnit }}</span></span
          >
        </span>
      </span>
      <!--
        状态词：行的右下角（绝对定位，见 styles.css 的 .tb）。
        放在 `.row` 这一层而不是 `.mt` 里——`.mt` 有 overflow:hidden，会把这个绝对定位的
        子元素裁掉。
      -->
      <span v-if="it.r.word" class="tb" :class="`tb-${it.r.tone}`">{{ it.r.word }}</span>
      <span v-if="it.r.unread" class="unb">{{ capNum(it.r.unread) }}</span>
      <span v-if="canPromote(it.r.t)" class="racts" @click.stop>
        <template v-if="promoting !== it.r.t.id">
          <span
            class="ract"
            role="button"
            tabindex="0"
            :aria-label="`立即执行 ${it.r.title}`"
            data-tip="立即执行"
            @click.stop="promoteTap(it.r)"
            @keydown.enter.stop.prevent="promoteTap(it.r)"
          >
            <ThunderboltOutlined aria-hidden="true" />
          </span>
        </template>
        <template v-else>
          <span
            class="ract ok"
            role="button"
            tabindex="0"
            aria-label="确认立即执行"
            @click.stop="promoteConfirm(it.r)"
            @keydown.enter.stop.prevent="promoteConfirm(it.r)"
            >确认</span
          >
          <span class="ract" role="button" tabindex="0" aria-label="取消立即执行"
            @click.stop="promoting = ''" @keydown.enter.stop.prevent="promoting = ''">取消</span
          >
        </template>
      </span>
      <span v-if="canClose(it.r.t)" class="racts" @click.stop>
        <template v-if="closing !== it.r.t.id">
          <span
            class="ract"
            role="button"
            tabindex="0"
            :aria-label="`${closeWord(it.r.t)} ${it.r.title}`"
            :data-tip="closeWord(it.r.t)"
            @click.stop="closeTap(it.r)"
            @keydown.enter.stop.prevent="closeTap(it.r)"
          >
            <CloseOutlined aria-hidden="true" />
          </span>
        </template>
        <template v-else>
          <span
            class="ract danger"
            role="button"
            tabindex="0"
            :aria-label="`确认${closeWord(it.r.t)}`"
            @click.stop="closeConfirm(it.r)"
            @keydown.enter.stop.prevent="closeConfirm(it.r)"
            >确认{{ closeWord(it.r.t) }}</span
          >
          <span class="ract" role="button" tabindex="0" aria-label="取消关闭"
            @click.stop="closing = ''" @keydown.enter.stop.prevent="closing = ''">取消</span
          >
        </template>
      </span>
    </button>

